---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n';
import sources from '../data/pdf-evidence.json';

const isEnglish = getLangFromUrl(Astro.url) === 'en';
const title = isEnglish ? 'PDF source excerpts' : 'PDF-фрагменты источников';
const description = isEnglish
  ? 'Archived excerpts from publications, project pages, and audiobook listings.'
  : 'Архивные фрагменты публикаций, страниц проектов и карточек аудиокниг.';
const introduction = isEnglish
  ? 'The PDFs contain screenshots of the original pages, with source links and capture dates.'
  : 'В PDF собраны снимки исходных страниц со ссылками и датами получения.';
const sections = [
  { group: 'publication', id: 'publications', title: isEnglish ? 'Publications and media mentions' : 'Публикации и упоминания в СМИ' },
  { group: 'other', id: 'projects', title: isEnglish ? 'Projects and recordings' : 'Проекты и записи' },
  { group: 'audiobook', id: 'audiobooks', title: isEnglish ? 'Audiobook listings' : 'Карточки аудиокниг' },
];
const originalLabel = isEnglish ? 'Original' : 'Оригинал';
const archiveLabel = isEnglish ? 'Archive (Russian)' : 'Архив';
---

<BaseLayout title={title} description={description}>
  <div class="evidence">
    <h1>{title}</h1>
    <p>{introduction}</p>
    {sections.map(({ group, id, title }) => (
      <section aria-labelledby={id}>
        <h2 id={id}>{title}</h2>
        <ul>
          {sources.filter((item) => item.group === group).map((item) => (
            <li>
              <a href={item.pdf} type="application/pdf">{item.title} (PDF)</a>
              <span class="links">
                <a href={item.source} target="_blank" rel="noopener" aria-label={`${originalLabel} · ${item.title}`}>{originalLabel}</a>
                {item.archiveId && (
                  <a href={`/archive/${item.archiveId}/`} aria-label={`${archiveLabel} · ${item.title}`}>{archiveLabel}</a>
                )}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p><a href={isEnglish ? '/en/publications/' : '/publications/'}>{isEnglish ? '← Back to publications' : '← К публикациям'}</a></p>
  </div>
</BaseLayout>

<style>
  .evidence { max-width: 800px; margin: 0 auto; line-height: 1.65; }
  h2 { margin: 1.5em 0 0.6em; }
  ul { padding-inline-start: 1.4em; }
  li { margin: 0.7em 0; overflow-wrap: anywhere; }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    font-size: 0.9em;
  }
  .links a {
    color: var(--color-text-muted);
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--color-text);
  }
</style>
